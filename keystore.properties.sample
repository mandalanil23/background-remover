# Copy this file to `keystore.properties` (which is git-ignored) and fill it in.
# `storeFile` is resolved relative to the project root.
#
# Create a keystore first:
#   keytool -genkeypair -v -keystore release.jks -keyalg RSA -keysize 4096 \
#           -validity 10000 -alias bgremover
#
storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=bgremover
keyPassword=CHANGE_ME
