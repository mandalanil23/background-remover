<?xml version="1.0" encoding="utf-8"?>
<!--
  Only user preferences are backed up. Processed images and temporary working files are
  deliberately excluded so that personal photos are never copied off the device.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <include domain="file" path="datastore/" />
    <exclude domain="file" path="processed/" />
    <exclude domain="file" path="working/" />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
